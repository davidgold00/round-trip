      <td style="padding-top:0in;text-indent:11.5pt;padding-left:0.037in;vertical-align:top;padding-bottom:0in;padding-right:0.037in;text-align:left;"><p style="margin-left:11.5pt;text-indent:0;tab-size:26.66px;font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><font style="color:#000000;white-space:pre-wrap;font-weight:bold;font-kerning:none;min-width:fit-content;">Total lease liabilities</font></p></td>
