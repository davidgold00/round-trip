      <td style="padding-top:0in;padding-left:0in;vertical-align:top;padding-bottom:0in;border-bottom:1pt solid #ffffff03;padding-right:0.01in;text-align:center;"><p style="tab-size:26.66px;font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;margin-right:0.03819444444444445in;text-align:right;"><font style="white-space:pre-wrap;font-kerning:none;min-width:fit-content;">&#160;</font></p></td>
