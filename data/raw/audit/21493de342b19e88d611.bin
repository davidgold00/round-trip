     <tr style="height:10pt;background-color:#cceeff;white-space:pre-wrap;word-break:break-word;">
      <td style="padding-top:0in;padding-left:0.037in;vertical-align:top;padding-bottom:0in;padding-right:0.037in;text-align:left;"><p style="tab-size:26.66px;font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><font style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">Equity value per share</font></p></td>
      <td style="padding-top:0in;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0.01in;text-align:left;"><p style="tab-size:26.66px;font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><font style="white-space:pre-wrap;font-kerning:none;min-width:fit-content;">&#160;</font></p></td>
